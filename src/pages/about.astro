---
import {getEntry,render} from 'astro:content';
import {getImage} from 'astro:assets';
import {resolveImage} from '../lib/images';
import {site} from '../lib/content';
import Seo from '../components/Seo.astro';
import '../styles/about-immersive.css';
import Personal from '../../content/personal.md';
import '../styles/personal-photos.css';
const about=await getEntry('about','about');if(!about)throw Error('Missing biography');
const {Content}=await render(about);
const background=await getImage({src:resolveImage(about.data.background!),format:'webp'});
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><Seo title="About Jessie Jia (Huiyu Jia) | Cornell · AI & Film" profile/><link rel="icon" href="/favicon.svg"/></head><body><div class="scene" style={`--scene:url("${background.src}")`} aria-hidden="true"></div><div class="shade" aria-hidden="true"></div><header><nav aria-label="Main navigation"><a class="active" aria-current="page" href="#main">About me</a><a href="/research/">Research</a><a href="/film/">Film</a></nav></header><main id="main"><Content/><div class="social" aria-label="Social profiles"><a href="https://www.instagram.com/j.xjia_/" aria-label="Instagram" title="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".9" fill="currentColor" stroke="none"/></svg></a><a href="https://letterboxd.com/JieC_x/" aria-label="Letterboxd" title="Letterboxd"><svg viewBox="0 0 30 20" aria-hidden="true"><circle cx="7" cy="10" r="6" fill="currentColor" opacity=".6"/><circle cx="15" cy="10" r="6" fill="currentColor" opacity=".8"/><circle cx="23" cy="10" r="6" fill="currentColor"/></svg></a></div></main><Personal/><div class="film-credit"><cite style="font-style:normal">{about.data.backgroundCredit}</cite><span>Dir. {about.data.backgroundDirector} · {about.data.backgroundYear}</span></div><footer class="about-footer"><a href={`mailto:${site.email}`}>{site.email}</a><a href="/">Home</a></footer></body></html>