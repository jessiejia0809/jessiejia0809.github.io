---
import '../styles/cinematography.css';
import '../styles/personal-photos.css';
import '../styles/film-portfolio.css';
import OnSet from '../../content/on-set.md';
import {getCollection} from 'astro:content';
import Page from '../layouts/Page.astro';
import Photo from '../components/Photo.astro';
import {filmography} from '../lib/content';
const creditCards:Record<string,string>={'Bad':'bad','UNDONE':'undone','TEAOAR':'teaoar','Delilah':'delilah','Alien in Ithaca':'aliens-in-ithaca','Athlete':'athlete','Interrogation':'the-interrogation','Milk shake kiss':'milkshake-kiss','Top of my School':'toms'};
const films=(await getCollection('films',({data})=>!data.draft)).sort((a,b)=>a.data.order-b.data.order);
---
<Page title="Film" theme="cinema">
<main id="main" class="film-page portfolio-page">
 <div class="film-index"><h1>Film</h1><nav aria-label="Film index"><a href="#works">All works · {films.length}</a><a href="#cinematography">Cinematography</a></nav></div>
 <div id="works" class="works-grid">
 {films.map(({id,data:d})=>{const cover=id==='zebra'?{image:'zebra-poster-front.png',alt:'Zebra official poster front with New York Shorts festival laurel'}:d.gallery.find(f=>f.visible);const credit=filmography.items.find(f=>creditCards[f.title]===id);const director=d.director||credit?.director;return <article id={id} class:list={['work-card',{'work-featured':d.featured}]}>
  {d.videoId&&<iframe class="work-video" src={`https://www.youtube-nocookie.com/embed/${d.videoId}`} title={`${d.title} — video`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>}
  <a class="work-link" href={`/film/${id}/`} aria-label={`Explore ${d.title}`}>
   {!d.videoId&&<div class="work-cover">
    {id==='zebra' ? (
      <div class="flip-card">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <Photo name="zebra-poster-front.png" alt="Zebra official poster front" />
          </div>
          <div class="flip-card-back">
            <Photo name="zebra-poster-back.png" alt="Zebra official poster back (with details)" />
          </div>
        </div>
      </div>
    ) : cover ? (
      <Photo name={cover.image} alt={cover.alt}/>
    ) : (
      <div class="film-placeholder"><span>{d.title}</span><small>Film still forthcoming</small></div>
    )}
    <span class="work-explore">Explore film ↗</span>
   </div>}
   <div class="work-label"><h2>{d.title}{d.videoId&&<span class="video-details">Details ↗</span>}</h2>{d.year&&<span>{d.year}</span>}</div>
   <p>{d.roles.length?d.roles.join(' / '):credit?.role||'Project details forthcoming'}{director&&` · Dir. ${director}`}</p>
   {d.featured&&<p class="work-logline">{d.logline}</p>}
  </a>
  {d.festivalSelection&&<a class="work-festival" href={d.festivalSelection.url}><img src="/images/festivals/new-york-shorts-2026.png" alt={`2026 Official Selection — ${d.festivalSelection.name}`} width="975" height="531" loading="lazy"/></a>}
 </article>})}
 </div>
<section id="cinematography" class="filmography"><h2>{filmography.title}</h2><div class="reel-grid">{filmography.reels.map((reel,index)=><figure class="reel"><iframe src={`https://www.youtube-nocookie.com/embed/${reel.videoId}`} title={reel.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe><figcaption><span>Reel {String(index+1).padStart(2,'0')}</span><a href={`https://www.youtube.com/watch?v=${reel.videoId}`}>Watch on YouTube ↗</a></figcaption></figure>)}</div></section><OnSet/></main></Page>
