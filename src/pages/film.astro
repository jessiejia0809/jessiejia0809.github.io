---
import {getCollection,render} from 'astro:content';import Page from '../layouts/Page.astro';import Frame from '../components/Frame.astro';import {filmography,site} from '../lib/content';
const films=await Promise.all((await getCollection('films',({data})=>!data.draft)).sort((a,b)=>a.data.order-b.data.order).map(async entry=>({...entry,...await render(entry),frames:entry.data.gallery.filter(f=>f.visible)})));
---
<Page title="Film" theme="cinema"><main id="main" class="film-page"><div class="film-index"><h1>Selected films</h1><nav aria-label="Film index">{films.map(f=><a href={`#${f.id}`}>{f.data.title}, {f.data.year}</a>)}</nav></div>{films.map(({id,data:d,frames,Content})=><section id={id} class="film-section"><Frame frame={frames[0]} title={d.title}/><div class="film-caption"><div><h2>{d.title} <span>{d.year}</span></h2><p>{d.roles.join(' / ')}{d.runtimeMinutes&&` · ${d.runtimeMinutes} min`}</p></div><p>{d.logline}</p><button class="film-notes" data-film={id}>About the film</button></div><details class="film-description" id={`notes-${id}`}><summary>About {d.title}</summary><h2>{d.title}</h2><div class="prose"><Content/></div><a href={`mailto:${site.email}?subject=${encodeURIComponent(d.title+' screening inquiry')}`}>Inquire about the film</a></details><div class:list={["frame-pair", {"supporting-grid":d.supportingGrid}]}>{frames.slice(1,d.supportingGrid?undefined:3).map(frame=><Frame frame={frame} title={d.title}/>)}</div>{!d.supportingGrid&&frames.slice(3).map(frame=><Frame frame={frame} title={d.title}/>)}</section>)}<section class="filmography"><h2>{filmography.title}</h2>{filmography.items.map(f=><p>{f.url ? <a href={f.url}>{f.title} ↗</a> : f.title}<span>{f.role}{f.director&&` · Dir. ${f.director}`}</span></p>)}</section></main><dialog id="film-dialog" aria-label="Film description"><button class="close-dialog" aria-label="Close film details">Close ×</button><div id="film-detail" class="dialog-content"></div></dialog><dialog id="image-dialog" aria-label="Film still"><button class="close-image" aria-label="Close image">Close ×</button><img id="large-image" alt=""/><p id="image-caption"></p></dialog><script>import '../scripts/gallery';</script></Page>
