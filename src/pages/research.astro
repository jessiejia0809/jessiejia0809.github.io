---
import {getCollection,render} from 'astro:content';import Page from '../layouts/Page.astro';import Photo from '../components/Photo.astro';import {research,site} from '../lib/content';
const advisors:Record<string,string>={'Qian Yang':'https://qianyang.co/','Kuan Fang':'https://kuanfang.github.io/'};
const scholar=site.social.find(profile=>profile.label==='Google Scholar');
const entries=await Promise.all((await getCollection('research',({data})=>!data.draft)).sort((a,b)=>a.data.order-b.data.order).map(async entry=>({...entry,...await render(entry)})));
---
<Page title={research.title} theme="academic" background={research.background} backgroundCredit={research.backgroundCredit} backgroundDirector={research.backgroundDirector} backgroundYear={research.backgroundYear}><main id="main" class="research-page"><h1>{research.title}</h1><p class="research-intro">{research.intro}</p><p class="muted">{research.affiliation} · <a href={`mailto:${site.email}`}>Contact</a>{scholar&&<a class="scholar-link" href={scholar.url}><svg viewBox="0 0 24 24" aria-hidden="true" width="15" height="15" fill="currentColor"><path d="M12 2 0 9l5 2.9V17h2v-3.9l5 2.9 9-5.25V17h2V9L12 2Zm0 16-5-2.9V19c3 2.7 7 2.7 10 0v-3.9L12 18Z"/></svg>Google Scholar</a>}{site.cv&&<a class="cv-link" href={site.cv}>CV</a>}</p>{research.groups.map(group=><section><h2>{group.title}</h2><p class="affiliation">{group.affiliation.split(/(Qian Yang|Kuan Fang)/).map(part=>advisors[part]?<a href={advisors[part]}>{part}</a>:part)}</p>{entries.filter(e=>e.data.group===group.id).map(({data:d,Content})=><article class={d.image?'publication':'text-project'}>{d.image&&<figure class="figure-link"><Photo name={d.image} alt={d.alt}/>{d.credit&&<figcaption>{d.credit}</figcaption>}</figure>}<div><h3>{d.title}</h3><div class="prose"><Content/></div>{d.citation&&<p class="citation">{d.citation.split(/(Jessie Jia)/gi).map(part=>part.toLowerCase()==='jessie jia'?<strong>{part}</strong>:part)}</p>}{d.links.length>0&&<p class="paper-links">{d.links.map(l=><a href={l.url}>{l.label}</a>)}</p>}</div></article>)}</section>)}</main></Page>
