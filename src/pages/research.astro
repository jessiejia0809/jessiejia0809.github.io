---
import {getCollection,render} from 'astro:content';import Page from '../layouts/Page.astro';import Photo from '../components/Photo.astro';import {research,site} from '../lib/content';
const entries=await Promise.all((await getCollection('research',({data})=>!data.draft)).sort((a,b)=>a.data.order-b.data.order).map(async entry=>({...entry,...await render(entry)})));
---
<Page title={research.title} theme="academic"><main id="main" class="research-page"><h1>{research.title}</h1><p class="research-intro">{research.intro}</p><p class="muted">{research.affiliation} · <a href={`mailto:${site.email}`}>Contact</a>{site.cv&&<a class="cv-link" href={site.cv}>CV</a>}</p>{research.groups.map(group=><section><h2>{group.title}</h2><p class="affiliation">{group.affiliation}</p>{entries.filter(e=>e.data.group===group.id).map(({data:d,Content})=><article class={d.image?'publication':'text-project'}>{d.image&&<figure class="figure-link"><Photo name={d.image} alt={d.alt}/>{d.credit&&<figcaption>{d.credit}</figcaption>}</figure>}<div><h3>{d.title}</h3><div class="prose"><Content/></div>{d.citation&&<p class="citation">{d.citation}</p>}{d.links.length>0&&<p class="paper-links">{d.links.map(l=><a href={l.url}>{l.label}</a>)}</p>}</div></article>)}</section>)}</main></Page>
