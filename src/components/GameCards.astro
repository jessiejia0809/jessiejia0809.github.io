---
import {games} from '../lib/content';
---
{games.items.map((game,i)=><article class="film-card game-card" id={i===0?'sweet-sweet-betrayal':'samsa'}>
 {i===0?<a class="film-card-media" href={game.url} target="_blank" rel="noopener noreferrer" aria-label="Sweet Sweet Betrayal source code"><img src="/images/personal/sweet-sweet-betrayal-banner.png" alt="Sweet Sweet Betrayal — sugar gliders in a forest" width="1090" height="440" loading="lazy"/></a>:<iframe class="film-card-media" src="https://www.youtube-nocookie.com/embed/uCZGuHmA-Bk" title="S.A.M.S.A. game video" loading="lazy" allow="encrypted-media; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen/>}
 <div class="film-card-heading"><h3>{game.title}</h3><a class="game-external" href={game.url} target="_blank" rel="noopener noreferrer" aria-label={i===0?'Sweet Sweet Betrayal source code (opens in new tab)':'S.A.M.S.A. on YouTube (opens in new tab)'}>↗</a></div>
 <p>{i===0?'Multiplayer mobile platformer · C++ / CUGL':'2D escort platformer · Java / LibGDX'}</p>
 {i===0&&<p class="game-award">Judge’s Choice · GDIAC 2025</p>}
</article>)}
<style is:global>
.game-card .film-card-media img{object-fit:contain}.game-card .game-external{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;color:#b8c9a3;font-size:17px}.game-card .game-award{font-size:10px;color:#c6c39e;margin-top:7px}
</style>
