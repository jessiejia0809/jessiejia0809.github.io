---
import Page from '../layouts/Page.astro';
import FilmCard from './FilmCard.astro';
import Photo from '../components/Photo.astro';
import {filmPreviews} from '../lib/film-previews';
import {getCollection} from 'astro:content';
import '../styles/film-universe.css';
import characters from '../../content/zebra-characters.json';
const films=(await getCollection('films',({data})=>!data.draft)).sort((a,b)=>a.data.order-b.data.order);
const stills=films.find(f=>f.id==='zebra')!.data.gallery.filter(f=>f.visible);
const remainingStills=stills.filter(f=>['zebra-middle-4.png','zebra-middle-5.png'].includes(f.image));
const parallelFrames=[
 {image:'zebra-visual/leslie-bed.png',alt:'Leslie / Bedroom',note:'Facing opposite directions, even in the same bed.'},
 {image:'zebra-visual/isabel-bed.png',alt:'Isabel / Bedroom',note:'A shared routine, experienced separately.'},
 {image:'zebra-visual/leslie-mirror.png',alt:'Leslie / Mirror',note:'Leslie occupies one side of the mirror composition.'},
 {image:'zebra-visual/isabel-mirror.png',alt:'Isabel / Mirror',note:'Isabel occupies the other: parallel lives within a shared home.'}
];
const boards=['5C','5G','7H','7M'];
const pieces=[
 {id:'leslie',kind:'Camera & editing',title:'Boy cut',note:'Leslie / Long handheld takes',video:'gallery-boy',poster:'boy.jpg',link:'/film/zebra/#visual-storytelling',description:'Leslie’s long handheld takes linger. An homage to Hu Bo’s An Elephant Sitting Still and Gus Van Sant’s Elephant.'},
 {id:'girl',kind:'Camera & editing',title:'Girl cut',note:'Isabel / Short, rapid actions',video:'gallery-girl',poster:'girl.jpg',link:'/film/zebra/#visual-storytelling',description:'Short, rapid actions reflect how quickly Isabel adapts to life, while Leslie struggles to keep pace.'},
 {id:'bedroom',kind:'Character & set design',title:'Bedroom',note:'Concept → Actual set',image:'zebra-set/bedroom-final.jpg',concept:'zebra-set/bedroom-concept.png',link:'/film/zebra/#set-design',description:'A shared space, framed through doorways. Photographs, books, film posters and keepsakes give the room its personal history.'},
 {id:'kitchen',kind:'Character & set design',title:'Kitchen',note:'Concept → Actual set',image:'zebra-set/kitchen-final.png',concept:'zebra-set/kitchen-concept.png',link:'/film/zebra/#set-design',description:'Everyday objects fill the counters. Cool light for Leslie, warmth for Isabel: two lives pulling in different directions within one room.'},
 {id:'room',kind:'Character & set design',title:'A life left on the walls',note:'Bedroom / Memory board',image:'zebra-set/memory-board.jpg',link:'/film/zebra/#set-design',description:'Photographs, postcards, travel keepsakes and film references. A small archive of the lives inside this shared apartment.'},
 {id:'board',kind:'Storyboard → Frame',title:'Before the camera',note:'5C / Lakeside',image:'zebra-storyboards/5C-board.png',swap:'zebra-storyboards/5C-shot.png',link:'/film/zebra/#storyboards',description:'From a lakeside composition on paper to the finished frame.'}
];
---
<Page title="Film" theme="cinema">
<div class="stills-backdrop" aria-hidden="true">{stills.map(f=><Photo name={f.image} alt=""/>)}</div>
<main id="main" class="universe aligned-universe">
 <a href="/film-index/" class="floating-films" aria-label="View all films"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="2" y="2" width="6" height="6" rx="1"/><rect x="12" y="2" width="6" height="6" rx="1"/><rect x="2" y="12" width="6" height="6" rx="1"/><rect x="12" y="12" width="6" height="6" rx="1"/></svg><span>All films</span></a>
 <section id="zebra" class="aligned-zebra" aria-label="Zebra interactive gallery">
 <aside class="zebra-intro"><a class="intro-poster" href="/film/zebra/" aria-label="Explore Zebra"><Photo name="zebra-poster.png" alt="Zebra official film poster" eager/></a><span class="tiny-label">01 / Narrative short · 2026</span><h1 class="sr-only">Zebra</h1><a class="zebra-instagram" href="https://www.instagram.com/zebraa_film/" target="_blank" rel="noopener noreferrer" aria-label="Zebra on Instagram (opens in new tab)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg><span>@zebraa_film</span></a><p class="zebra-logline">A boy who always sees a crying zebra and a girl who needs to be seen.</p><a class="enter-zebra" href="/film/zebra/">More details ↗</a><p class="details-contents">Director’s message · Production bible · Pitch deck · Behind the scenes</p></aside>
 <div class="zebra-sections">
 <section id="gallery-motion" class="aligned-section"><header><h2>Lovers living parallel lives</h2><span>Framing / Rhythm / Light</span></header><div class="parallel-montage"><figure class="parallel-frame"><Photo name="zebra-set/kitchen-final.png" alt="Leslie in the cool kitchen and Isabel in the warm hallway, divided within a shared frame"/></figure><div class="parallel-four">{parallelFrames.map(f=><div><Photo name={f.image} alt={f.alt}/></div>)}</div></div><div class="cut-grid">{pieces.slice(0,2).map(p=><button class="aligned-piece" data-piece={p.id} aria-label={`Open ${p.title}`}><video muted loop playsinline preload="metadata" poster={`/media/zebra/${p.poster}`} data-preview><source src={`/media/zebra/${p.video}.mp4`} type="video/mp4"/></video><span class="piece-caption"><strong>{p.title}</strong><span>↗</span></span><small>{p.note}</small><span class="piece-extra">{p.description}</span></button>)}</div></section>
 <section id="gallery-directing" class="aligned-section directing-section"><header><h2>Directing</h2><span>Building an emotional world</span></header><div class="directing-study"><video class="directing-screen" muted loop playsinline controls preload="metadata" poster="/media/zebra/directing-leslie.jpg" data-preview aria-label="Zebra — Leslie scene, directing study"><source src="/media/zebra/directing-leslie.mp4" type="video/mp4"/></video><button class="directing-reveal" aria-expanded="false" aria-controls="directing-notes">Behind the performance <span>Hover / tap +</span></button><div id="directing-notes" class="directing-notes"><div><blockquote>Initially, I tried to prescribe every emotion, but gradually learned to trust the world we had created and <strong>allow actors to discover feelings I had never anticipated</strong>. Paradoxically, the most moving performances emerged when actors stopped trying to <em>act</em> and began to live as their characters.</blockquote><div class="directing-method"><article><h3>Leslie’s references</h3><p>Peng Yuchang in <em>大象席地而坐</em> and Greg Hsu in <em>阳光普照</em>: a slow, withdrawn everyday presence. Takeshi Kaneshiro in <em>如果爱</em>: feeling carried through the eyes. For voice-over, Tony Leung in <em>春光乍泄</em>—telling someone a story, without a theatrical delivery.</p></article><article><h3>The life behind the scene</h3><p>Writing briefly brings Leslie alive, but frustration follows: dissatisfaction with the world and the Africa he cannot reach. By the lake, the zebra becomes a mirror. Resentment, anger and shame drain into helplessness; his fixed gaze gradually empties.</p></article><article><h3>Directing this moment</h3><p>On the hillside, hold the stillness. Small trembles and a deep breath precede fear and helplessness. The city lights bring back Isabel and their past; resolve gives way to hesitation, grief and exhaustion. Let the changes emerge through breath, eyes and pauses.</p></article></div></div></div></div></section>
 <section id="gallery-music" class="aligned-section"><header><h2>Music</h2><span>Press play. Stay a while.</span></header><div class="inline-music">{[{id:'party',title:'Party',image:'zebra-music/party.png',note:'Chill, confused, offbeat → free.',description:'Chill, confused, modern and offbeat—gradually becoming free as Isabel moves through the party. Written primarily for scene 10, with possible echoes in scenes 6–7. The dance sequence in And Your Bird Can Sing inspired the bar scene and Isabel’s growing feeling of freedom.',reference:'And Your Bird Can Sing — “Main”'},{id:'love-is-so',title:'Love Is So…',image:'zebra-music/ending.png',note:'Youth and regret. A positive ending melody.',description:'Pop and singable for the end credits: youth and regret (青春、遗憾), held in a positive melody. A love song Leslie and Isabel used to sing together, now carrying the cracks in their relationship. Conceived for the ending, with the melody recurring earlier—such as Isabel singing in the shower.',reference:'City of Stars · 后来 · First Love'}].map(t=><article>{t.id==='party'?<video class="party-reference-video" muted loop playsinline preload="metadata" poster="/media/zebra/gallery-party.jpg" data-preview aria-label="Isabel dancing at the party in Zebra"><source src="/media/zebra/gallery-party.mp4" type="video/mp4"/></video>:<Photo name={t.image} alt={t.title+' — Zebra film frame'}/>}<h3>{t.title}</h3><p>{t.note}</p><audio controls preload="metadata" aria-label={t.title}><source src={`/media/zebra/${t.id}.mp3`} type="audio/mpeg"/></audio><details class="hover-notes"><summary>Sound & references <span>Hover / tap +</span></summary><div class="hover-notes-body"><p>{t.description}</p><p>References / {t.reference}</p></div></details></article>)}</div></section>
 <section id="gallery-design" class="aligned-section"><header><h2>Character & set design</h2><span>The lives inside the rooms</span></header><p class="design-intro">Muted, desaturated, slightly cool. The apartment holds the traces of Leslie and Isabel’s shared life.</p><div class="set-pairs compact-set-pairs">{pieces.slice(2,4).map(p=><article><h3>{p.title}</h3><button class="set-comparison-button hover-comparison" aria-pressed="false" aria-label={`Toggle ${p.title} concept and actual shot`}><Photo name={p.concept!} alt={`${p.title} design concept`}/><Photo name={p.image!} alt={`${p.title} actual set`} class="comparison-actual"/><span>Concept → Actual · Hover / tap</span></button><details class="hover-notes"><summary>Set design notes <span>Hover / tap +</span></summary><div class="hover-notes-body"><p>{p.description}</p>{p.id==='bedroom'?<><p>“Framed through doorways, mirrors, windows.” A desk, books, film posters and keepsakes give the room its history. Natural light, realistic, soft shadows.</p><div class="set-note-images"><Photo name="zebra-set/desk-detail.jpg" alt="Bedroom desk details"/><Photo name="zebra-set/keepsakes.jpg" alt="Memory book and portrait"/></div></>:<p>Dishes, cookware, a toaster and breakfast remnants crowd the narrow counters. Wide compositions and negative space keep Leslie and Isabel apart even when they are close.</p>}</div></details></article>)}</div><div class="design-details"><button data-piece="room" aria-label="Open memory board"><Photo name="zebra-set/memory-board.jpg" alt="Bedroom memory board"/><span>The memory board ↗</span></button>{characters.map(c=><article class="character-hover-study"><button class="character-reveal" data-character={c.name.toLowerCase()} aria-label={`Explore ${c.name}`}><span class="character-images"><Photo name={`zebra-studies/${c.looks.find(l=>l.letter==='B')!.image}.png`} alt={`${c.name} costume study`}/><Photo class="character-hover" name={`zebra-characters/${c.name.toLowerCase()}.jpg`} alt={`${c.name} character poster`}/></span><span>{c.name} / Character & costume ↗</span></button><details class="hover-notes"><summary>Costume notes <span>Hover / tap +</span></summary><div class="hover-notes-body"><p>{c.intro}</p>{c.looks.map(l=><section><h4>{l.letter} / {l.scene}</h4><ul>{l.items.map(item=><li>{item}</li>)}</ul></section>)}</div></details></article>)}</div></section>
 <details class="objects-note"><summary>Objects & motifs <span>Explore +</span></summary><Photo name="zebra-visual/shoes-orange.png" alt="Leather shoes and sneakers flank an orange and keys"/><p>Leather shoes suggest career and working life; sneakers hold onto youth and school days. Between them, an orange—a small detail that returns later in the film.</p></details>
 <section class="aligned-section"><header><h2>From sketch to screen</h2><span>Hover / tap to compare</span></header><div class="four-storyboards">{boards.map(id=><button class="storyboard-switch hover-comparison" aria-pressed="false" aria-label={`Toggle ${id} storyboard and actual shot`}><Photo name={`zebra-storyboards/${id}-board.png`} alt={`${id} storyboard`}/><Photo name={`zebra-storyboards/${id}-shot.png`} alt={`${id} actual shot`} class="finished-shot comparison-actual"/><span>{id} / Sketch → Screen</span></button>)}</div></section>
 <section id="gallery-stills" class="aligned-section"><header><h2>Stills</h2></header><div class="still-contact-sheet">{remainingStills.map(f=><div><Photo name={f.image} alt={f.alt}/></div>)}</div></section>
 </div></section>
 <section id="film-collection" class="universe-collection"><header><div><span class="tiny-label">The collection</span><h2>Other worlds.</h2></div><p>Stories, experiments & collaborations.<br/>Choose a film to step inside.</p></header>
 <div class="universe-films">{films.filter(f=>f.id!=='zebra').map(film=><FilmCard film={film} previewObserved/>)}</div>
 </section>
 <div class="universe-signoff"><a href="/film-index/">View all film cards ↗</a></div>
</main>
<dialog id="fragment-dialog" aria-labelledby="fragment-title"><button class="fragment-close" aria-label="Close detail">Close ×</button><div id="fragment-content"></div></dialog>
{pieces.map(p=><template id={`piece-${p.id}`}><div class="detail-media">{p.video?<video controls playsinline loop muted poster={`/media/zebra/${p.poster}`}><source src={`/media/zebra/${p.video}.mp4`} type="video/mp4"/></video>:<Photo name={p.swap||p.image!} alt={p.note}/>}</div><div class="fragment-detail-copy"><span class="tiny-label">{p.kind}</span><h2 id="fragment-title">{p.title}</h2><p>{p.description}</p></div></template>)}
{characters.map(c=><template id={`character-${c.name.toLowerCase()}`}><div class="character-detail"><Photo name={`zebra-characters/${c.name.toLowerCase()}.jpg`} alt={`${c.name} character poster`}/><div class="fragment-detail-copy"><span class="tiny-label">Character / Costume</span><h2 id="fragment-title">{c.name} <small>{c.age}</small></h2><p>{c.profile}</p><div class="character-looks">{c.looks.map(l=><figure><Photo name={`zebra-studies/${l.image}.png`} alt={`${c.name} costume ${l.letter}`}/><figcaption>{l.letter} / {l.scene}</figcaption><ul class="costume-item-notes">{l.items.map(item=><li>{item}</li>)}</ul></figure>)}</div></div></div></template>)}
<script>
for(const notes of document.querySelectorAll<HTMLDetailsElement>('.hover-notes')){
 let pinned=false;
 const summary=notes.querySelector('summary')!;
 const area=notes.closest('article')||notes;
 area.addEventListener('pointerenter',(event)=>{if((event as PointerEvent).pointerType==='mouse')notes.open=true;});
 area.addEventListener('pointerleave',()=>{if(!pinned&&!notes.contains(document.activeElement))notes.open=false;});
 summary.addEventListener('click',event=>{event.preventDefault();pinned=!pinned;notes.open=pinned;});
 notes.addEventListener('focusout',()=>{setTimeout(()=>{if(!pinned&&!notes.contains(document.activeElement)&&!area.matches(':hover'))notes.open=false;},0);});
}

const directingStudy=document.querySelector<HTMLElement>('.directing-study')!;
const directingToggle=document.querySelector<HTMLButtonElement>('.directing-reveal')!;
let pinned=false;
function revealDirecting(show:boolean){directingStudy.classList.toggle('notes-visible',show);directingToggle.setAttribute('aria-expanded',String(show));directingStudy.querySelector<HTMLElement>('.directing-notes')!.inert=!show;}
revealDirecting(false);
directingStudy.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse')revealDirecting(true);});
directingStudy.addEventListener('pointerleave',()=>{if(!pinned&&!directingStudy.contains(document.activeElement))revealDirecting(false);});
directingToggle.addEventListener('click',()=>{pinned=!pinned;revealDirecting(pinned);});
directingStudy.addEventListener('focusout',()=>{setTimeout(()=>{if(!pinned&&!directingStudy.contains(document.activeElement)&&!directingStudy.matches(':hover'))revealDirecting(false);},0);});

for(const button of document.querySelectorAll<HTMLButtonElement>('.hover-comparison'))button.addEventListener('click',()=>button.setAttribute('aria-pressed',String(button.getAttribute('aria-pressed')!=='true')));
const musicTracks=[...document.querySelectorAll<HTMLAudioElement>('.inline-music audio')];
for(const track of musicTracks)track.addEventListener('play',()=>musicTracks.forEach(other=>{if(other!==track)other.pause();}));
const previews=[...document.querySelectorAll<HTMLVideoElement>('video[data-preview]')];

const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
let paused=reduced.matches;
const visible=new Set<HTMLVideoElement>();
const dialog=document.querySelector<HTMLDialogElement>('#fragment-dialog')!;
const content=document.querySelector<HTMLElement>('#fragment-content')!;
let opener:HTMLElement|null=null;
function sync(){for(const v of previews){if(!paused&&visible.has(v)&&!dialog.open&&!document.hidden){v.play().catch(()=>{});}else v.pause();}}
const observer=new IntersectionObserver(entries=>{for(const e of entries){const v=e.target as HTMLVideoElement;e.isIntersecting?visible.add(v):visible.delete(v);}sync();},{threshold:.2});
previews.forEach(v=>{v.muted=true;observer.observe(v);});
reduced.addEventListener('change',()=>{paused=reduced.matches;sync();});document.addEventListener('visibilitychange',sync);
function open(button:HTMLElement){opener=button;musicTracks.forEach(t=>t.pause());dialog.showModal();document.body.style.overflow="hidden";sync();}
for(const button of document.querySelectorAll<HTMLButtonElement>('[data-character], [data-still], [data-parallel]'))button.addEventListener('click',()=>{const id=button.dataset.parallel!==undefined?`parallel-${button.dataset.parallel}`:button.dataset.character?`character-${button.dataset.character}`:`still-${button.dataset.still}`;const template=document.getElementById(id) as HTMLTemplateElement;content.replaceChildren(template.content.cloneNode(true));open(button);});
for(const button of document.querySelectorAll<HTMLButtonElement>('[data-piece]'))button.addEventListener('click',()=>{const template=document.getElementById(`piece-${button.dataset.piece}`) as HTMLTemplateElement;content.replaceChildren(template.content.cloneNode(true));open(button);content.querySelector<HTMLVideoElement>('video')?.play().catch(()=>{});});
for(const button of document.querySelectorAll<HTMLButtonElement>('[data-youtube]'))button.addEventListener('click',()=>{const heading=document.createElement('h2');heading.id='fragment-title';heading.textContent=button.dataset.title!;const iframe=document.createElement('iframe');iframe.src=`https://www.youtube-nocookie.com/embed/${button.dataset.youtube}?autoplay=1`;iframe.title=button.dataset.title!;iframe.allow='autoplay; encrypted-media; picture-in-picture; fullscreen';iframe.allowFullscreen=true;content.replaceChildren(heading,iframe);open(button);});
document.querySelector('.fragment-close')!.addEventListener('click',()=>dialog.close());
dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close();}});
dialog.addEventListener('close',()=>{document.body.style.overflow='';content.querySelectorAll<HTMLMediaElement>('video,audio').forEach(v=>v.pause());content.replaceChildren();opener?.focus();sync();});sync();
</script>

</Page>
